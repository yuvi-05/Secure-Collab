# Flask & JWT Secrets
SECRET_KEY=dev-secure-collab-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-super-secret-key-change-in-production

# Dedicated single Super Admin login; set both values to enable it.
# Use a unique email and a strong password, and do not commit populated values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Server Host & Port
HOST=0.0.0.0
PORT=5000

# Chat message retention in seconds (one year by default)
CHAT_MESSAGE_TTL_SECONDS=31536000

# Database Configuration
# Leave empty for local SQLite (default) or provide PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_collab

# Redis configuration (optional, for multi-worker Socket.IO coordination)
# REDIS_URL=redis://localhost:6379/0

# File Upload Directory
UPLOAD_FOLDER=uploads

# AI Assistant Configuration
# Supports OpenAI, OpenRouter, Groq, Ollama, DeepSeek, or any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
